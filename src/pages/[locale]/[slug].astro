---
/* Locale page route. Renders `pages` entities excluding slug 'home' for
 * each configured locale. getStaticPaths enumerates Settings.locales; a locale with no
 * matching content produces no routes. Drafts are absent from production output entirely:
 * no route, no file, no sitemap entry. */
import { getCollection } from 'astro:content';
import { settings } from '../../content.config';
import { localeToSegment } from '../../contract/defs';
import { resolveDraftFlag } from '../../contract/env';
import BlockList from '../../components/BlockList.astro';
import { loadLinkIndex } from '../../lib/site-links';
import { linkContext, resolveBlockLinks } from '../../lib/links';
import { resolveBlockMedia } from '../../lib/media';
import type { ResolvedBlock } from '../../lib/links';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Props = {
  page: Awaited<ReturnType<typeof getCollection<'pages'>>>[number];
  /* Resolved in getStaticPaths, not here: a broken reference then fails during path
   * generation, before any HTML exists, rather than part-way through writing a page. */
  blocks: ResolvedBlock[];
};

const { page, blocks } = Astro.props as Props;

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const includeDrafts = resolveDraftFlag();
  const linkIndex = await loadLinkIndex();

  /* TWO PASSES, both here and neither in a component, because a reference that cannot be
   * resolved should fail during path generation rather than part-way through writing a page.
   * Link.ref is a translation-group id, not a URL (src/lib/links.ts); MediaRef.ref is a path
   * rooted at the content repository, not a URL (src/lib/media.ts). So what reaches BlockList
   * carries real hrefs and real srcs, and neither a raw ULID nor a raw content path is
   * representable downstream. Separate passes because a link needs the link index and media
   * needs a directory listing, and neither has any use for the other's. */
  const resolve = (entry: { data: { id: string; slug: string; locale: string; status: 'draft' | 'published'; blocks: unknown[] } }) =>
    resolveBlockMedia(resolveBlockLinks(entry.data.blocks as never, linkContext(linkIndex, {
      collection: 'pages',
      id: entry.data.id,
      slug: entry.data.slug,
      locale: entry.data.locale,
      status: entry.data.status,
    }, includeDrafts)));

  return settings.locales
    .flatMap(locale => {
      // Get all pages for this locale, excluding slug 'home'
      const pageList = pages.filter(
        p => p.data.locale === locale && p.data.slug !== 'home',
      );

      // Exclude drafts from production output entirely
      const filtered = pageList.filter(
        p => includeDrafts || p.data.status !== 'draft',
      );

      return filtered.map(p => ({
        params: { locale: localeToSegment(locale), slug: p.data.slug },
        props: { page: p, blocks: resolve(p) },
      }));
    });
}
/* THE TITLE IS RENDERED HERE, and until it was, `page` was the only entity kind whose title
 * never reached the page. blog/[slug], blog/index, authors/[slug] and tags/[tag] all emit the
 * title as the h1; these two did not, so a page shipped with NO h1 at all and an h2 as its
 * highest heading — an accessibility and SEO defect, not merely an inconsistency.
 *
 * The block catalogue is what settles it rather than taste: blocks.ts restricts `heading` to
 * levels 2, 3 and 4, so an h1 CANNOT be authored as body content. That rule only makes sense if
 * the template owns the h1, which is what this is.
 *
 * The consequence of the gap was duplication nobody could see was duplication: the seed content
 * carried a level-2 heading block repeating the title, as a stand-in for the h1 that was never
 * emitted. Editing the title then changed the browser tab and nothing on the page, which is
 * exactly how it was reported.
 *
 * `page.data.title`, never `seo.title`. The seo override is for the document title and search
 * results — what BaseLayout receives above — and an on-page heading that silently differed from
 * the title an editor typed is the same class of surprise this is fixing. blog/[slug].astro
 * already draws that line the same way. */
---

<BaseLayout
  title={page.data.seo?.title ?? page.data.title}
  description={page.data.seo?.description}
  locale={page.data.locale}
>
  <header class="site-page-header site-container">
    <h1 class="site-page-title">{page.data.title}</h1>
  </header>
  <div class="site-blocks">
    <BlockList blocks={blocks} />
  </div>
</BaseLayout>

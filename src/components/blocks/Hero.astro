---
/* jamground/hero. A dynamic block: save() returns null in the editor, so nothing about this
 * block's markup is WordPress's to define — but this component is no longer its sole renderer.
 * The block's `edit` renders the same structure into the editor canvas, which is what makes
 * design/blocks/hero.css apply in both places, and ADR-0013 makes that structure a specified
 * artifact rather than two templates kept in step by hand.
 *
 * So the structure lives once, in design/markup/hero.ts, and this component renders it. There is
 * no second definition here to drift from: a class renamed in the module changes both renderers,
 * and a class renamed HERE is not expressible, because there is no markup here to rename.
 *
 * THE RUNTIME IMPORT IS NEW, AND THIS FILE USED TO ARGUE AGAINST ONE. The argument was real:
 * test/blocks/*.test.mjs compile this file with @astrojs/compiler-rs and render it through
 * astro/container with NO Vite, rewriting import specifiers by hand in a temp directory that does
 * not mirror src/, so every runtime import is another rewrite rule for that harness. It is paid
 * once here rather than per-component — design/markup/ imports nothing outside itself, so a single
 * rule in each harness covers all three blocks and anything added later.
 *
 * Link.ref (../../contract/defs.ts) targets a translation GROUP id, not a URL. Resolution happens
 * UPSTREAM, in the route's getStaticPaths, via resolveBlockLinks() (../../lib/links.ts) — so what
 * arrives here is a ResolvedLink carrying `href`. The markup module's `href` is optional because
 * the EDITOR has no resolver and renders the label without a target (09 §7); on the site an
 * unresolved cta is a build failure, which is what the guard below is for. */
import type { z } from 'zod';
import type { Block } from '../../contract/blocks.ts';
import type { ResolvedLink } from '../../lib/links.ts';
import { toHtml } from '../../../design/markup/node.ts';
import { hero } from '../../../design/markup/hero.ts';

type Props = Omit<Extract<z.infer<typeof Block>, { type: 'hero' }>, 'type' | 'cta'> & {
  cta?: ResolvedLink;
};

const { heading, body, media, cta } = Astro.props as Props;

/* The control that makes upstream resolution mandatory rather than conventional. A future
 * route that renders blocks without resolving them fails the build here, loudly, instead of
 * emitting a bare ULID that every gate in the repo would pass. It is checked here rather than in
 * the markup module because the module is shared with the editor, where an absent href is correct.
 */
if (cta && typeof (cta as { href?: unknown }).href !== 'string') {
  throw new Error(
    'hero cta reached the renderer unresolved — blocks must go through resolveBlockLinks() (INV-11)',
  );
}
---
<Fragment set:html={toHtml(hero({ heading, body, media, cta }))} />

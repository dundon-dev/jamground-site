---
/* jamground/cta. Dynamic block; see Hero.astro for why the structure lives in design/markup/
 * rather than here, for why resolution happens upstream in the route, and for what `link.href`
 * is. `link` is required on this block, so the guard below is unconditional. */
import type { z } from 'zod';
import type { Block } from '../../contract/blocks.ts';
import type { ResolvedLink } from '../../lib/links.ts';
import { toHtml } from '../../../design/markup/node.ts';
import { cta } from '../../../design/markup/cta.ts';

type Props = Omit<Extract<z.infer<typeof Block>, { type: 'cta' }>, 'type' | 'link'> & {
  link: ResolvedLink;
};

const { heading, body, link } = Astro.props as Props;

if (typeof (link as { href?: unknown })?.href !== 'string') {
  throw new Error(
    'cta link reached the renderer unresolved — blocks must go through resolveBlockLinks() (INV-11)',
  );
}
---
<Fragment set:html={toHtml(cta({ heading, body, link }))} />

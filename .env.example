# .env.example — the operator's half of the configuration.
#
# Copy to `.env` and edit. `.env` is gitignored; this file is not (the `!.env.example`
# negation in .gitignore exists solely because the `.env.*` line above it would otherwise
# swallow this file and a clean clone would find no placeholder at all).
#
# THE LINE THIS FILE SITS ON. The fork's identity — domain, GitHub org, repository names,
# the PUBLIC OAuth client id — is NOT here. It is declared in `jamground.config.mjs` and
# `infra/ansible/group_vars/all.yml`, in git, because it is identical for everyone who
# deploys this fork and is baked into the editor bundle at build time regardless. What is
# here is everything that belongs to the OPERATOR'S MACHINE and to the one box they own:
# an address, an ssh user, a key path. Those differ per operator and must never be
# committed.
#
# No secret VALUE ever appears in this file, in `.env`, or anywhere in this repository.
# The three secrets are placed on the box by hand and are named below by PATH only.

# ── The build ──────────────────────────────────────────────────────────────────────────

# Where the content repository is checked out. The build reads `$JAMGROUND_CONTENT_DIR/content`
# (content lives in its own repository and never beside build config).
# Unset defaults to the sibling directory `../jamground-content`.
JAMGROUND_CONTENT_DIR=../jamground-content

# Include `status: draft` entities in the build. Unset or empty means drafts are excluded;
# `1` includes them. ANY other value is a hard build error rather than a silent default —
# a typo here would publish drafts, so it fails loudly instead (src/contract/env.ts).
# Set for preview builds only, never for production.
JAMGROUND_INCLUDE_DRAFTS=

# ── The box (infra/ansible/inventory.yml reads these three) ─────────────────────────────

# The VPS's address. Unset, the inventory falls back to 203.0.113.10 — RFC 5737 TEST-NET-3,
# deliberately unroutable — so a clone that configured nothing fails to connect rather than
# converging a stranger's server.
JAMGROUND_VPS_HOST=203.0.113.10

# The account Ansible connects as. Every role assumes it can escalate to root.
JAMGROUND_VPS_SSH_USER=root

# The private key for that account, on THIS machine. A path, never a key.
JAMGROUND_VPS_SSH_KEY=~/.ssh/id_ed25519

# ── Recorded for the operator; nothing in this tree reads them yet ──────────────────────
# Both were hardcoded in infra/RUNBOOK.md, which is rewritten in a later phase. They are
# named here so a fork knows they are its own values to supply, not the reference
# deployment's.

# The Cloudflare zone the DNS records live in. 32 hex characters, from the zone's overview
# page. Needed by hand when creating the A records and by the ACME DNS-01 credentials below.
JAMGROUND_CLOUDFLARE_ZONE_ID=0123456789abcdef0123456789abcdef

# The GitHub account whose fine-grained PAT the box uses to pull content and post statuses.
# A machine account, not a person: it holds write access to the content repository.
JAMGROUND_GITHUB_BOT=your-bot-account

# ── Secrets: PATHS ONLY. Never a value, here or in .env ─────────────────────────────────
#
# Each is placed on the box by hand, readable only by the one service that needs it. These
# are not environment variables — they are the file paths the roles expect, listed so an
# operator provisioning a fresh box knows exactly what must exist before a converge can
# succeed, and knows that this repository has never held any of them.
#
#   /etc/jamground/oauth-client.secret
#       The OAuth App's Client SECRET. Read by the auth broker
#       alone, which runs as its own unprivileged account for exactly this reason. Its
#       counterpart, the PUBLIC client id, is in jamground.config.mjs and in git.
#       Mode 0640, owner root, group the broker's own.
#
#   /root/jamground.pat
#       The bot's fine-grained personal access token, as first dropped on the box. The
#       bot_token role moves it to /etc/jamground/github-bot.token and deletes this
#       world-readable original.
#
#   /etc/jamground/acme/dns.ini
#       The Cloudflare API token certbot's DNS-01 challenge authenticates with, in
#       certbot-dns-cloudflare's ini format. Scoped to DNS edit on the one zone above.
#       Mode 0600 — certbot refuses to use it otherwise.

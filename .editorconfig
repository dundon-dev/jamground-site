root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown needs trailing whitespace for hard breaks in some dialects; we do not use
# them, and trailing whitespace in content/ is a validation error regardless.
trim_trailing_whitespace = true

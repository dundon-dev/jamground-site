# {{ ansible_managed }}
#
# Managed wholesale by the nginx role, so `validate: nginx -t -c %s` tests the whole live
# config rather than a fragment that could never pass on its own. `conf.d` is included for
# roles that converge after this one (the editor shell, the webhook receiver) so they can add a
# vhost without editing this file.
#
# No `listen [::]` anywhere: infra/RUNBOOK.md §The-environment records this host as having no
# IPv6 at all, and `nginx -t` does not catch a bind failure on a real reload the way it catches
# a syntax error — only the converge does, and there is no console to recover a box wedged on
# a bad reload.

user www-data;
pid /run/nginx.pid;
worker_processes auto;

events {
    worker_connections 768;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    include /etc/nginx/conf.d/*.conf;

    # ---- production: {{ nginx_domain }} -----------------------------------------------------
    server {
        listen 80;
        server_name {{ nginx_domain }};

        root {{ nginx_release_root }}/public;
        index index.html;

        location = / { return 301 /en-us/; }    # from Settings.defaultLocale

        location / {
            try_files $uri $uri/ =404;
        }
    }
{% if jamground_cert_stat.stat.exists %}

    server {
        listen 443 ssl;
        server_name {{ nginx_domain }};

        ssl_certificate {{ nginx_cert_dir }}/fullchain.pem;
        ssl_certificate_key {{ nginx_cert_dir }}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        root {{ nginx_release_root }}/public;
        index index.html;

        location = / { return 301 /en-us/; }    # from Settings.defaultLocale

        location / {
            try_files $uri $uri/ =404;
        }
    }
{% endif %}

    # ---- previews: one static root per open pull request --------------------------------------
    # Populated by jamground-preview-build (roles/isolation), which the queue consumer runs when a
    # pull request opens or moves, and removed when it closes. Neither costs a reload: the root is
    # resolved per request from the named capture, and the digit-only capture is the whole
    # path-traversal guard, because $prnum can never contain `/` or `..`.
    #
    # THE `location = /` REDIRECT IS THE SAME LINE THE PRODUCTION BLOCKS CARRY, AND IT IS NOT
    # OPTIONAL HERE. This site emits no bare-root index.html — only the default locale's, which
    # jamground-deploy and jamground-preview-build both assert on before publishing — so without
    # it `/` falls through to try_files with no index to find and nginx answers 403. That is the
    # ONE address jamground.config.mjs's previewUrlFor() hands an editor, so the whole preview
    # feature read as broken while every preview behind it was building correctly. The target is
    # RELATIVE: nginx's default `absolute_redirect on` resolves it against the request's own Host,
    # so a preview redirects to its own /en-us/ and never to production. `return` is answered in
    # the rewrite phase, before $prnum is resolved into a root, so it also costs nothing for a
    # preview number that does not exist.
    # test/gates/preview-work-root.test.mjs holds production and preview to the same answer at /.
    server {
        listen 80;
        server_name ~^pr-(?<prnum>[0-9]+)\.preview\.{{ nginx_domain | regex_escape }}$;

        root {{ nginx_previews_root }}/$prnum;
        index index.html;

        location = / { return 301 /en-us/; }    # from Settings.defaultLocale

        location / {
            try_files $uri $uri/ =404;
        }
    }
{% if jamground_cert_stat.stat.exists %}

    server {
        listen 443 ssl;
        server_name ~^pr-(?<prnum>[0-9]+)\.preview\.{{ nginx_domain | regex_escape }}$;

        ssl_certificate {{ nginx_cert_dir }}/fullchain.pem;
        ssl_certificate_key {{ nginx_cert_dir }}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        root {{ nginx_previews_root }}/$prnum;
        index index.html;

        location = / { return 301 /en-us/; }    # from Settings.defaultLocale

        location / {
            try_files $uri $uri/ =404;
        }
    }
{% endif %}

    # ---- webhook deliveries: {{ nginx_hooks_domain }} ------------------------------------------
    # THE FIRST HOP. roles/webhook registers a GitHub webhook pointing at
    # https://{{ nginx_hooks_domain }}/ and runs the receiver on 127.0.0.1:{{ nginx_hooks_port }},
    # but until this block existed no server_name matched that name: every delivery fell through
    # to the default server and GitHub recorded 405 for all of them. A receiver nothing routes to
    # never receives, so the queue it writes stayed empty and looked healthy.
    #
    # The receiver owns every decision about a request, and this block must not pre-empt any of
    # them: no `limit_except`, no method allowlist, no rewrite of the body — it answers 401 on a
    # bad signature and 202 on success, and an nginx-authored 405 or 413 in front of that would
    # be indistinguishable, from GitHub's delivery log, from the receiver having refused.
    # client_max_body_size is set to the receiver's OWN cap (DEFAULT_MAX_BODY_BYTES in
    # infra/hooks/lib/receiver.mjs) rather than left at nginx's 1 MB default, for that same
    # reason: below it, nginx would reject a delivery the receiver would have accepted.
    #
    # proxy_pass with no URI part, so the request line reaches the receiver unmodified. The HMAC
    # is computed over the raw bytes (infra/hooks/lib/hmac.mjs), so anything that re-encodes the
    # body breaks every signature; nginx does not touch it, and nothing here asks it to.
    server {
        listen 80;
        server_name {{ nginx_hooks_domain }};

        client_max_body_size 5m;

        location / {
            proxy_pass http://127.0.0.1:{{ nginx_hooks_port }};
            proxy_set_header Host $host;
        }
    }
{% if jamground_cert_stat.stat.exists %}

    # The live certificate covers *.{{ nginx_domain }}, which is the SAN {{ nginx_hooks_domain }}
    # matches — this block requests nothing new, the same way the preview blocks above do not.
    server {
        listen 443 ssl;
        server_name {{ nginx_hooks_domain }};

        ssl_certificate {{ nginx_cert_dir }}/fullchain.pem;
        ssl_certificate_key {{ nginx_cert_dir }}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        client_max_body_size 5m;

        location / {
            proxy_pass http://127.0.0.1:{{ nginx_hooks_port }};
            proxy_set_header Host $host;
        }
    }
{% endif %}
}

#!/bin/bash
# {{ ansible_managed }}
#
# jamground-selfcheck — HTTP, disk headroom, certificate expiry, unit-liveness and
# production-freshness checks:
# monitoring and alerting on the production root, watching production availability and error
# rates. Runs as jamground-build, unprivileged, fired every five minutes by
# jamground-selfcheck.timer and once by hand in
# verify/selfcheck.yml. It never notifies anyone itself — OnFailure= on the service wrapping
# this script is the whole of the alerting path (jamground-selfcheck-alert), so this script's
# only job is to fail loudly and let systemd take it from there.
#
# The site's actual page is the DEFAULT LOCALE INDEX, not `/`: `/` is
# an nginx 301 by construction and can never legitimately return 200. Checking `/` alone — as a
# 301 satisfied by a redirect into a 404 downstream — would be a false green, so
# it is asserted here as a 301 ALONGSIDE /en-us/'s 200, never as the only HTTP assertion, and
# without following the redirect (a check that follows cannot tell the two failures apart).
#
# Every check below runs against 127.0.0.1 with the domain forced by --resolve/-servername,
# never against public DNS: a check running ON the box that depends on the box's own outbound
# DNS to see the box is a check that can fail for a reason that has nothing to do with what it
# is checking. (An off-box uptime monitor is the one that must reach the public domain, and it
# is deliberately a separate, human-provisioned check — a check running on the VPS cannot
# observe the VPS being down.)
set -uo pipefail

# Rendered by roles/selfcheck from templates/jamground-selfcheck.j2. This one value is the
# reason this file is a template rather than files/: it was the last hardcoded copy of the
# domain outside group_vars, sitting in a SHIPPED SCRIPT where a sweep over role defaults
# would never have found it — and a selfcheck asserting against the wrong host is a monitor
# that reports green about a site nobody is serving. Everything else here is still a literal
# on purpose: thresholds and the unit list are this script's own policy, not the fork's
# identity, and a script systemd invokes with no control node in the loop cannot template
# itself at run time.
domain={{ jamground_domain }}
disk_path=/
disk_max_percent=90
cert_min_days=14
units=(nginx.service jamground-webhook.service)

# The automatic-deploy chain, by the paths it leaves on disk. Literals, like every threshold above
# and for the same reason — a script systemd invokes with no control node in the loop cannot
# template itself at run time. Each is mirrored in another role's defaults by hand:
# roles/deploy (deploy_requests_dir, deploy_current), roles/content_repos (the checkout), and the
# two build scripts (the lock).
deploy_requests=/var/lib/jamground/deploy-requests
release_manifest=/srv/jamground/current/manifest.json
content_checkout=/srv/jamground/repos/content
build_lock=/srv/jamground/repos/site/.build.lock

fail() {
  echo "jamground-selfcheck: $1" >&2
  exit 1
}

# --- HTTP: / redirects, /en-us/ actually serves -----------------------------------------------
root_code=$(curl -s -o /dev/null -w '%{http_code}' --max-redirs 0 --resolve "${domain}:80:127.0.0.1" "http://${domain}/")
[ "$root_code" = "301" ] || fail "http://${domain}/ returned ${root_code}, expected 301"

# -k: expiry is this script's own job, below, with a clean day-count rather than a bare curl
# SSL error — a curl SSL error and a serving-but-404 error must not be indistinguishable here.
index_code=$(curl -s -o /dev/null -w '%{http_code}' -k --resolve "${domain}:443:127.0.0.1" "https://${domain}/en-us/")
[ "$index_code" = "200" ] || fail "https://${domain}/en-us/ returned ${index_code}, expected 200"

# --- Disk headroom ------------------------------------------------------------------------------
disk_percent=$(df --output=pcent "$disk_path" | tail -n1 | tr -dc '0-9')
[ -n "$disk_percent" ] || fail "could not read disk usage for ${disk_path}"
[ "$disk_percent" -lt "$disk_max_percent" ] || fail "${disk_path} is ${disk_percent}% full, at or above the ${disk_max_percent}% threshold"

# --- Certificate expiry, read from what is actually SERVED, not a file this unprivileged
# account may have no permission to open -----------------------------------------------------
end_date=$(echo | openssl s_client -connect "127.0.0.1:443" -servername "${domain}" 2>/dev/null \
  | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
[ -n "$end_date" ] || fail "could not read the certificate served on 127.0.0.1:443 (SNI ${domain})"

end_epoch=$(date -d "$end_date" +%s) || fail "could not parse certificate end date: ${end_date}"
now_epoch=$(date -u +%s)
days_left=$(( (end_epoch - now_epoch) / 86400 ))
[ "$days_left" -ge "$cert_min_days" ] || fail "certificate expires in ${days_left} day(s), below the ${cert_min_days}-day threshold"

# --- Unit liveness -------------------------------------------------------------------------------
for unit in "${units[@]}"; do
  systemctl is-active --quiet "$unit" || fail "${unit} is not active"
done

# --- The automatic production deploy ---------------------------------------------------------
#
# Three checks, because a merged pull request that never reaches the live site is invisible from
# every other angle: the editor said "published" and meant it, GitHub shows the merge, the box's
# units are all active, the certificate is valid, and the site serves — the previous release. That
# is not hypothetical. It ran for three merges, and nothing here reported it.
#
# Every one is guarded on the thing it inspects existing, so a box mid-way through its first
# converge — or one where roles/deploy has not run yet — skips rather than fails. A monitor that
# goes red while the box is still being built teaches people to ignore it.

# 1. A deploy that ran and failed. jamground-deploy never flips on a failure, so production is
#    still serving correctly; what is wrong is that a merge is not on it and nobody was watching.
if [ -f /etc/systemd/system/jamground-deploy-request.service ]; then
  ! systemctl is-failed --quiet jamground-deploy-request.service \
    || fail "jamground-deploy-request has failed; a merged change is not on the live site (journalctl -u jamground-deploy-request)"
fi

# 2. A deploy that never ran. A request sitting unclaimed means the .path unit is not firing —
#    the silent failure mode a path unit has, and the one systemctl reports as green. Ten minutes
#    is far longer than a claim takes and far shorter than anyone would notice by hand.
if [ -d "$deploy_requests" ]; then
  stale_requests=$(find "$deploy_requests" -maxdepth 1 -name '*.json' -mmin +10 | head -n1)
  [ -z "$stale_requests" ] \
    || fail "a deploy request has been unclaimed for over 10 minutes (${stale_requests}); jamground-deploy-request.path is not firing"
fi

# 3. The end state, which is the only one of the three that catches a merge lost some OTHER way —
#    before the units existed, or by a request nothing ever wrote. Compares what `current` was
#    built from against what the content checkout actually holds, which is the same comparison
#    roles/content_repos makes at converge time; the difference is that this one runs every five
#    minutes instead of when an operator happens to converge.
#
#    SKIPPED WHILE A BUILD HOLDS THE LOCK, because during a deploy the two are legitimately
#    different. `flock -n` is the test: it fails immediately if anything holds it, and if nothing
#    does it is held for the two commands below and released when the subshell exits. Running it
#    in a subshell is what keeps fd 9 from staying open for the rest of this script.
if [ -f "$release_manifest" ] && [ -d "$content_checkout/.git" ] && [ -f "$build_lock" ]; then
  (
    exec 9>"$build_lock" 2>/dev/null || exit 0
    flock -n 9 || exit 0
    deployed=$(sed -n 's/.*"contentSha":"\([^"]*\)".*/\1/p' "$release_manifest")
    current=$(git -C "$content_checkout" rev-parse --short=7 HEAD 2>/dev/null)
    [ -n "$deployed" ] && [ -n "$current" ] || exit 0
    if [ "$deployed" != "$current" ]; then
      echo "jamground-selfcheck: the live site was built from content ${deployed}, but the content checkout is at ${current} — a merge has not reached production" >&2
      exit 1
    fi
  ) || exit 1
fi

echo "jamground-selfcheck: all checks passed"

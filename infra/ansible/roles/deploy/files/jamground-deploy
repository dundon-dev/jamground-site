#!/bin/bash
# jamground-deploy — build, verify, create a fresh release
# directory, and flip `current` to it ONLY if the build exited 0, the default locale's
# index page exists and the release manifest parses. A failed build never
# becomes current.
#
# This is the deliverable that used to be infra/deploy.sh: Ansible ships
# it to the box and runs it there, rather than owning its logic, because a deploy must be
# runnable by the webhook with no control node in the loop.
#
# Requires JAMGROUND_SITE_CHECKOUT and JAMGROUND_CONTENT_CHECKOUT in the environment — the two
# already-pulled repository checkouts, by path. Where those checkouts live, and keeping them
# pulled, is content_repos' job; this script only builds what is already on disk and flips.
#
# _CHECKOUT, and not _REPO, for a reason that is load-bearing rather than stylistic. The build
# this script runs resolves jamground.config.mjs out of THIS SAME ENVIRONMENT, and that module
# reads JAMGROUND_SITE_REPO and JAMGROUND_CONTENT_REPO as the two repository NAMES — the `repo`
# half of `org/repo`. Handing it a directory under those names does not fail; it resolves
# `<org>//srv/jamground/repos/content` and then waits for the first thing at build time to reach
# for a slug. A checkout directory and a repository name are two different things, so they carry
# two different names — test/gates/deploy-env-names.test.mjs is what holds the two sets apart.
#
# JAMGROUND_CONTENT_DIR is how the build itself finds content/ — it names the content
# repository's ROOT, the same directory JAMGROUND_CONTENT_CHECKOUT already names, so this script
# exports one as the other rather than leaving it unset and falling back to a sibling directory
# that does not exist on this box. The resolved absolute path is recorded in the release manifest
# so a build that read the wrong tree is not indistinguishable from one that read the right one.
#
# The build itself is expected to run as jamground-build (unprivileged, no
# secrets); the flip needs the two no-argument sudo wrappers only `jamground` holds. `sudo -n`
# degrades cleanly: root can call the wrappers directly, jamground reaches them via the grant,
# and anything else fails loudly rather than hanging on a password prompt.
set -euo pipefail

root=/srv/jamground
releases="$root/releases"
release_switch=/usr/local/sbin/jamground-release-switch
reload_nginx=/usr/local/sbin/jamground-reload-nginx

: "${JAMGROUND_SITE_CHECKOUT:?JAMGROUND_SITE_CHECKOUT must name the site repository checkout}"
: "${JAMGROUND_CONTENT_CHECKOUT:?JAMGROUND_CONTENT_CHECKOUT must name the content repository checkout}"

content_sha=$(git -C "$JAMGROUND_CONTENT_CHECKOUT" rev-parse --short=7 HEAD)
site_sha=$(git -C "$JAMGROUND_SITE_CHECKOUT" rev-parse --short=7 HEAD)
utc=$(date -u +%Y%m%dT%H%M%SZ)
release="${utc}-${content_sha}-${site_sha}"
release_dir="$releases/$release"

fail() {
  echo "jamground-deploy: $1" >&2
  rm -rf -- "$release_dir"
  exit 1
}

echo "jamground-deploy: building $release"
mkdir -p "$release_dir"

# The box's own copy of the deployment's identity, written by roles/deploy from the environment
# the operator sourced their `.env` into. Nothing else on this box knows it: `.env` lives on the
# operator's machine and Ansible copies it nowhere, so a build that does not read this one
# resolves jamground.config.mjs to its committed placeholders and emits `example.com` canonical
# URLs — exiting 0, on a box serving production.
#
# Sourced only IF PRESENT, deliberately. A fork that has converged nothing, or that is mid-way
# through its first converge, has no file here, and this script must still produce a coherent
# placeholder build: refusing to deploy over a missing identity would take a site down for the
# one mistake the placeholders already handle gracefully.
#
# Sourced whole rather than read key by key, so this script names none of the six and a seventh
# value added to the template arrives here for nothing. The price is that the file WINS over
# anything already exported into this shell — the box's converged identity beats an ad-hoc
# override, which is the right way round for the production path.
deploy_env=/etc/jamground/deploy.env
if [ -r "$deploy_env" ]; then
  set -a
  . "$deploy_env"
  set +a
fi

# After the sourcing, and not before: this script knows where the content checkout actually is
# and the identity file does not, so the export below is the last word on it either way.
content_dir=$(readlink -f "$JAMGROUND_CONTENT_CHECKOUT")
export JAMGROUND_CONTENT_DIR="$content_dir"

if ! ( cd "$JAMGROUND_SITE_CHECKOUT" && npm ci && npm run build ); then
  fail "the build exited non-zero; current is unchanged"
fi

[ -d "$JAMGROUND_SITE_CHECKOUT/dist" ] || fail "$JAMGROUND_SITE_CHECKOUT/dist does not exist after a build that exited 0"

cp -a "$JAMGROUND_SITE_CHECKOUT/dist" "$release_dir/public"

# from Settings.defaultLocale — this site never emits a bare-root
# public/index.html, only the default locale's, the same path
# roles/nginx/templates/nginx.conf.j2 already redirects / to.
[ -f "$release_dir/public/en-us/index.html" ] || fail "$release_dir/public/en-us/index.html does not exist; a deploy never flips without it"

manifest="$release_dir/manifest.json"
cat > "$manifest" <<JSON
{"release":"$release","contentSha":"$content_sha","siteSha":"$site_sha","contentDir":"$content_dir","builtAt":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
JSON

node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$manifest" \
  || fail "$manifest does not parse; a deploy never flips without a parseable manifest"

echo "jamground-deploy: flipping current to $release"
ln -sfn "releases/$release" "$root/.current.tmp"

if [ "$(id -u)" -eq 0 ]; then
  "$release_switch"
  "$reload_nginx"
else
  sudo -n "$release_switch"
  sudo -n "$reload_nginx"
fi

echo "jamground-deploy: $release is current"

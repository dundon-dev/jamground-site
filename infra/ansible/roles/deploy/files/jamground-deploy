#!/bin/bash
# jamground-deploy — build, verify, create a fresh release
# directory, and flip `current` to it ONLY if the build exited 0, the default locale's
# index page exists and the release manifest parses. A failed build never
# becomes current.
#
# This is the deliverable that used to be infra/deploy.sh: Ansible ships
# it to the box and runs it there, rather than owning its logic, because a deploy must be
# runnable by the webhook with no control node in the loop.
#
# Requires JAMGROUND_SITE_CHECKOUT and JAMGROUND_CONTENT_CHECKOUT in the environment — the two
# already-pulled repository checkouts, by path. Where those checkouts live, and keeping them
# pulled, is content_repos' job; this script only builds what is already on disk and flips.
#
# _CHECKOUT, and not _REPO, for a reason that is load-bearing rather than stylistic. The build
# this script runs resolves jamground.config.mjs out of THIS SAME ENVIRONMENT, and that module
# reads JAMGROUND_SITE_REPO and JAMGROUND_CONTENT_REPO as the two repository NAMES — the `repo`
# half of `org/repo`. Handing it a directory under those names does not fail; it resolves
# `<org>//srv/jamground/repos/content` and then waits for the first thing at build time to reach
# for a slug. A checkout directory and a repository name are two different things, so they carry
# two different names — test/gates/deploy-env-names.test.mjs is what holds the two sets apart.
#
# JAMGROUND_CONTENT_DIR is how the build itself finds content/ — it names the content
# repository's ROOT, the same directory JAMGROUND_CONTENT_CHECKOUT already names, so this script
# exports one as the other rather than leaving it unset and falling back to a sibling directory
# that does not exist on this box. The resolved absolute path is recorded in the release manifest
# so a build that read the wrong tree is not indistinguishable from one that read the right one.
#
# TWO HALVES, TWO PRIVILEGE LEVELS, AND THIS SCRIPT SEPARATES THEM ITSELF. The build runs as
# jamground-build — unprivileged, no sudo, no secrets, because it executes repository content.
# The flip needs the no-argument sudo wrappers only `jamground` holds, or root. Invoked as
# root, this script DROPS to jamground-build for `npm ci && npm run build` and then calls the two
# wrappers directly; invoked as anything else it builds as itself and reaches the wrappers through
# `sudo -n`. One question, `id -u`, asked once and answered the same way in both places: "can I
# drop for the build" and "do I need the grant to flip" are the same question about the same
# account. `sudo -n` degrades cleanly either way, failing loudly rather than hanging on a prompt.
#
# IT SERIALISES AGAINST PREVIEW BUILDS, which it did not until merges could trigger it. See the
# `build_lock` block below for the path, why every other path is wrong, and why it re-execs.
#
# THIS PARAGRAPH USED TO SAY THE FIRST SENTENCE AND THE CODE DID NOT DO IT. Every
# `npm ci && npm run build` ran as whoever invoked the script, and roles/content_repos invoked it
# with no become_user — as root. So every artefact under the SHARED site checkout came out
# root-owned: .astro/, node_modules/, dist/. Production never noticed, because root can write what
# root owns. jamground-preview-build, which correctly runs as jamground-build, could not: the
# first real preview build died with EACCES on .astro/content.d.ts. A comment that describes
# something its code does not do is only ever found by whatever the code breaks next, and here
# that was a class of build nobody had run yet. test/gates/deploy-unprivileged-build.test.mjs now
# holds the two together, so the sentence above cannot go back to being an aspiration.
set -euo pipefail

root=/srv/jamground
releases="$root/releases"
release_switch=/usr/local/sbin/jamground-release-switch
reload_nginx=/usr/local/sbin/jamground-reload-nginx

: "${JAMGROUND_SITE_CHECKOUT:?JAMGROUND_SITE_CHECKOUT must name the site repository checkout}"
: "${JAMGROUND_CONTENT_CHECKOUT:?JAMGROUND_CONTENT_CHECKOUT must name the content repository checkout}"

# ONE LOCK, SHARED WITH jamground-preview-build, AND WHY IT IS HERE RATHER THAN LOWER DOWN.
#
# `npm ci` below DELETES node_modules before repopulating it, in the SHARED site checkout that
# jamground-preview-build reads for every preview. Preview builds have serialised against each
# other since they existed; a production deploy took no lock at all, so the one overlap that
# actually corrupts something — this script pulling the dependency tree out from under a preview
# build mid-flight — was the one nothing prevented. That was survivable while every deploy was an
# operator's deliberate act. It stopped being survivable the moment a merged pull request could
# start one on its own.
#
# THE LOCK PATH IS DERIVED FROM THE CHECKOUT, and every other candidate is unopenable by one side
# or the other. /srv/previews/.build.lock, where jamground-preview-build's lock used to live, is on
# the fixed-size loopback image (roles/isolation) that a production deploy has no business writing
# and that does not exist before that role converges. /srv/jamground/… would need /srv/jamground in
# the queue consumer's ReadWritePaths (roles/webhook runs it under ProtectSystem=strict), which
# would hand a build that executes pull-request content write access to releases/ and the `current`
# symlink. The site checkout is already a ReadWritePath — because the build writes it — so it is
# the one inode both accounts can open, inside the sandbox and out.
#
# RE-EXEC UNDER flock(1) RATHER THAN `exec 9>` + `flock 9`. test/gates/deploy-unprivileged-build
# EXECUTES this script against a PATH of stubs, on machines with no /srv/jamground and, on macOS,
# no flock at all. A shell redirection cannot be stubbed by a PATH entry; an external command can.
# -E 75 separates "could not acquire the lock" from whatever the child itself exited with, and
# JAMGROUND_DEPLOY_LOCKED is what stops the re-exec re-executing.
build_lock="$JAMGROUND_SITE_CHECKOUT/.build.lock"
if [ -z "${JAMGROUND_DEPLOY_LOCKED:-}" ]; then
  export JAMGROUND_DEPLOY_LOCKED=1
  status=0
  flock -w 900 -E 75 "$build_lock" "$0" "$@" || status=$?
  if [ "$status" -eq 75 ]; then
    echo "jamground-deploy: timed out after 900s waiting for $build_lock; a preview build is still" \
      "using $JAMGROUND_SITE_CHECKOUT. current is unchanged." >&2
  fi
  exit "$status"
fi

content_sha=$(git -C "$JAMGROUND_CONTENT_CHECKOUT" rev-parse --short=7 HEAD)
site_sha=$(git -C "$JAMGROUND_SITE_CHECKOUT" rev-parse --short=7 HEAD)
utc=$(date -u +%Y%m%dT%H%M%SZ)
release="${utc}-${content_sha}-${site_sha}"
release_dir="$releases/$release"

fail() {
  echo "jamground-deploy: $1" >&2
  rm -rf -- "$release_dir"
  exit 1
}

echo "jamground-deploy: building $release"
mkdir -p "$release_dir"

deploy_env=/etc/jamground/deploy.env
build_user=jamground-build

# Resolved by THIS script and not taken from the identity file below: this script knows where the
# content checkout actually is and that file does not. It is recorded in the release manifest, so
# a build that read the wrong tree is not indistinguishable from one that read the right one.
content_dir=$(readlink -f "$JAMGROUND_CONTENT_CHECKOUT")

# THE BUILD, AS ONE STEP THAT CAN RUN ON THE FAR SIDE OF A PRIVILEGE DROP.
#
# Everything it needs arrives as an ARGUMENT or is re-read inside it, because `sudo` runs the
# command in a reset environment (`env_reset`, on by default) — whatever this shell exported does
# NOT cross. Passing the values by name instead was not an option and is not a detail: this script
# must go on naming none of the six identity values, which is the property
# test/gates/deploy-env-names.test.mjs holds. So the identity file is sourced on the far side,
# whole, exactly as it was sourced here before.
#
# The box's own copy of the deployment's identity, written by roles/deploy from the environment
# the operator sourced their `.env` into. Nothing else on this box knows it: `.env` lives on the
# operator's machine and Ansible copies it nowhere, so a build that does not read this one
# resolves jamground.config.mjs to its committed placeholders and emits `example.com` canonical
# URLs — exiting 0, on a box serving production.
#
# Sourced only IF PRESENT, deliberately. A fork that has converged nothing, or that is mid-way
# through its first converge, has no file here, and this script must still produce a coherent
# placeholder build: refusing to deploy over a missing identity would take a site down for the
# one mistake the placeholders already handle gracefully.
#
# Sourced whole rather than read key by key, so this script names none of the six and a seventh
# value added to the template arrives here for nothing. The price is that the file WINS over
# anything already exported into this shell — the box's converged identity beats an ad-hoc
# override, which is the right way round for the production path.
#
# The two orderings inside are the two that were here before, unchanged: the identity file is
# sourced FIRST so the converged identity beats anything ambient, and JAMGROUND_CONTENT_DIR is
# exported LAST so this script has the final word on where content/ is. `set -euo pipefail` is
# restated because `bash -c` starts a fresh shell, and a build step that lost errexit would let
# `npm ci` fail and `npm run build` produce a stale dist/ that flips as if it were new.
build_step='
set -euo pipefail
if [ -r "$1" ]; then
  set -a
  . "$1"
  set +a
fi
export JAMGROUND_CONTENT_DIR="$2"
cd "$3"
npm ci
npm run build
'

if [ "$(id -u)" -eq 0 ]; then
  # `-u` needs root, and root is the only account here that has it: jamground holds exactly three
  # no-argument sudo entries and jamground-build holds none, which is what makes `id -u` the whole
  # test rather than a name comparison. `-n` for the reason the flip below uses it — a box that
  # cannot authorise this must fail loudly, not wait on a prompt. `-H` sets HOME to
  # jamground-build's own; npm writes a cache and a log directory under it, and a build that
  # inherited root's HOME would die with an EACCES naming ~/.npm rather than the account.
  # roles/users creates that home (`create_home: true`) precisely so this account has one — a
  # system account is not given one by default, and `env_reset` alone would not be enough if a
  # box ever put HOME in env_keep.
  build_cmd=(sudo -n -H -u "$build_user" bash -c "$build_step" jamground-deploy \
    "$deploy_env" "$content_dir" "$JAMGROUND_SITE_CHECKOUT")
  build_as="$build_user"
else
  # Already unprivileged: jamground-build IS the target account, and jamground holds no `-u` grant
  # to reach it with. Dropping again is impossible and unnecessary — the property being protected
  # is that the build carries no privilege, and here it already does not.
  build_cmd=(bash -c "$build_step" jamground-deploy \
    "$deploy_env" "$content_dir" "$JAMGROUND_SITE_CHECKOUT")
  build_as=$(id -un)
fi

# Said out loud, every deploy, because the whole of this defect was invisible: a root-run build
# leaves artefacts nobody else can overwrite, exits 0, and serves the site correctly.
echo "jamground-deploy: the build runs as $build_as"
if ! "${build_cmd[@]}"; then
  fail "the build exited non-zero; current is unchanged"
fi

[ -d "$JAMGROUND_SITE_CHECKOUT/dist" ] || fail "$JAMGROUND_SITE_CHECKOUT/dist does not exist after a build that exited 0"

cp -a "$JAMGROUND_SITE_CHECKOUT/dist" "$release_dir/public"

# from Settings.defaultLocale — this site never emits a bare-root
# public/index.html, only the default locale's, the same path
# roles/nginx/templates/nginx.conf.j2 already redirects / to.
[ -f "$release_dir/public/en-us/index.html" ] || fail "$release_dir/public/en-us/index.html does not exist; a deploy never flips without it"

manifest="$release_dir/manifest.json"
cat > "$manifest" <<JSON
{"release":"$release","contentSha":"$content_sha","siteSha":"$site_sha","contentDir":"$content_dir","builtAt":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
JSON

node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$manifest" \
  || fail "$manifest does not parse; a deploy never flips without a parseable manifest"

echo "jamground-deploy: flipping current to $release"
ln -sfn "releases/$release" "$root/.current.tmp"

if [ "$(id -u)" -eq 0 ]; then
  "$release_switch"
  "$reload_nginx"
else
  sudo -n "$release_switch"
  sudo -n "$reload_nginx"
fi

echo "jamground-deploy: $release is current"
